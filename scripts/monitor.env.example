# Copy to scripts/monitor.env (gitignored) for vpn-monitor-once.sh / vpn-hourly-monitor.sh
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
PVE_PASSWORD=
PVE_HOST=192.168.0.158
CT_ID=112
# Optional: alert if VPN egress matches this (home IP without tunnel)
VPN_HOME_IP=
INTERVAL_SEC=300
RUNS=12
# Timer install: bash scripts/install-vpn-monitor-timer.sh  (every 5 min via systemd user timer)
# ALERT_COOLDOWN_SEC=1800

# --- Monitor behaviour (API-first; SSH optional) ---
# Fast HTTP check from your LAN — no SSH, cannot wedge the LXC
MONITOR_API_URL=http://192.168.0.74:3000/api/v2/health
MONITOR_API_TIMEOUT_SEC=8
# 5-min timer: keep SSH off (0). Hourly script enables deep SSH by default.
MONITOR_SSH_DEEP=0
MONITOR_SSH_TIMEOUT_SEC=20
MONITOR_MAX_RUNTIME_SEC=60
MONITOR_STALE_SSH_SEC=120